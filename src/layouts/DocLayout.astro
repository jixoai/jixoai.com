---
import BaseLayout from './BaseLayout.astro';
import DocSidebar from '../components/markdown/DocSidebar.astro';
import TableOfContents from '../components/markdown/TableOfContents.astro';
import DocNavigation from '../components/markdown/DocNavigation.astro';
import { getCollection } from 'astro:content';
import { getDocNavigation } from '../utils/docs.js';
import type { MarkdownHeading } from 'astro';

interface Props {
  title: string;
  description?: string;
  slug: string;
  headings?: MarkdownHeading[];
}

const { title, description, slug, headings = [] } = Astro.props;

const allDocs = await getCollection('docs');
const navigation = getDocNavigation(allDocs, slug);
---

<BaseLayout title={title} description={description}>
  <div class="container mx-auto px-4 py-8">
    <div class="flex gap-8">
      <DocSidebar docs={allDocs} currentSlug={slug} />

      <article class="flex-1 min-w-0 prose prose-slate dark:prose-invert max-w-none">
        <h1>{title}</h1>
        {description && <p class="lead">{description}</p>}

        <slot />

        <DocNavigation
          prev={navigation.prev ? { slug: navigation.prev.slug, title: navigation.prev.data.title } : undefined}
          next={navigation.next ? { slug: navigation.next.slug, title: navigation.next.data.title } : undefined}
        />
      </article>

      <div class="w-64 flex-shrink-0">
        <TableOfContents headings={headings} />
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  /* Custom prose styles */
  :global(.prose) {
    @apply text-foreground;
  }

  :global(.prose h1, .prose h2, .prose h3, .prose h4) {
    @apply scroll-mt-4;
  }

  :global(.prose a) {
    @apply text-primary hover:underline;
  }

  :global(.prose code) {
    @apply bg-secondary px-1.5 py-0.5 rounded text-sm;
  }

  :global(.prose pre) {
    @apply bg-secondary rounded-lg p-4;
  }

  :global(.prose pre code) {
    @apply bg-transparent p-0;
  }
</style>

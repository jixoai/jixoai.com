---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  lang?: string;
}

const { title, description = 'Jixo AI - Open Source AI Projects', lang = 'en' } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/jpeg" href="/logo.jpg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body class="scrollbar-thin scrollbar-track-transparent scrollbar-thumb-[color-mix(in_srgb,currentColor,transparent)]">
    <header class="border-b">
      <nav class="container mx-auto px-4 py-4 flex items-center justify-between">
        <a href="/" class="text-2xl font-bold">
          <img src="/logo.jpg" alt="Jixo AI" class="h-10 inline-block mr-2" />
          Jixo AI
        </a>
        <div class="flex gap-6">
          <a href="/projects" class="hover:text-primary">Projects</a>
          <a href="/blog" class="hover:text-primary">Blog</a>
          <a href="/docs" class="hover:text-primary">Docs</a>
        </div>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="border-t mt-16">
      <div class="container mx-auto px-4 py-8 text-center text-muted-foreground">
        <p>&copy; {new Date().getFullYear()} Jixo AI. Open Source Projects.</p>
      </div>
    </footer>
  </body>
</html>

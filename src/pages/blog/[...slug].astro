---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <article class="container mx-auto px-4 py-16 max-w-4xl">
    <header class="mb-8">
      <h1 class="text-4xl font-bold mb-4">{post.data.title}</h1>
      <div class="flex items-center gap-4 text-muted-foreground mb-4">
        <time datetime={post.data.pubDate.toISOString()}>
          {post.data.pubDate.toLocaleDateString('en-US', {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
          })}
        </time>
        <span>•</span>
        <span>{post.data.author}</span>
      </div>
      {post.data.tags && post.data.tags.length > 0 && (
        <div class="flex flex-wrap gap-2">
          {post.data.tags.map((tag) => (
            <span class="px-3 py-1 text-sm bg-secondary rounded-full">
              {tag}
            </span>
          ))}
        </div>
      )}
    </header>

    <div class="prose prose-lg prose-slate dark:prose-invert max-w-none">
      <Content />
    </div>

    <footer class="mt-12 pt-8 border-t">
      <a href="/blog" class="text-primary hover:underline">← Back to Blog</a>
    </footer>
  </article>
</BaseLayout>

<style>
  @reference "../../styles/global.css";

  :global(.prose) {
    @apply text-foreground;
  }

  :global(.prose h1, .prose h2, .prose h3, .prose h4) {
    @apply scroll-mt-4;
  }

  :global(.prose a) {
    @apply text-primary hover:underline;
  }

  :global(.prose code) {
    @apply bg-secondary px-1.5 py-0.5 rounded text-sm;
  }

  :global(.prose pre) {
    @apply bg-secondary rounded-lg p-4;
  }

  :global(.prose pre code) {
    @apply bg-transparent p-0;
  }
</style>

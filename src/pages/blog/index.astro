---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .filter(post => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title="Blog - Jixo AI">
  <section class="container mx-auto px-4 py-16">
    <h1 class="text-4xl font-bold mb-8">Blog & News</h1>
    <p class="text-xl text-muted-foreground mb-12">
      Updates, announcements, and insights from the Jixo AI team
    </p>

    {posts.length === 0 ? (
      <div class="text-center py-16">
        <p class="text-muted-foreground">No blog posts yet. Check back soon!</p>
      </div>
    ) : (
      <div class="grid gap-8">
        {posts.map((post) => (
          <article class="border rounded-lg p-6 hover:shadow-lg transition-shadow">
            <a href={`/blog/${post.slug}`} class="block">
              <h2 class="text-2xl font-bold mb-2 hover:text-primary">
                {post.data.title}
              </h2>
              {post.data.description && (
                <p class="text-muted-foreground mb-4">{post.data.description}</p>
              )}
              <div class="flex items-center gap-4 text-sm text-muted-foreground">
                <time datetime={post.data.pubDate.toISOString()}>
                  {post.data.pubDate.toLocaleDateString('en-US', {
                    year: 'numeric',
                    month: 'long',
                    day: 'numeric',
                  })}
                </time>
                <span>•</span>
                <span>{post.data.author}</span>
              </div>
              {post.data.tags && post.data.tags.length > 0 && (
                <div class="flex flex-wrap gap-2 mt-4">
                  {post.data.tags.map((tag) => (
                    <span class="px-2 py-1 text-xs bg-secondary rounded-full">
                      {tag}
                    </span>
                  ))}
                </div>
              )}
            </a>
          </article>
        ))}
      </div>
    )}
  </section>
</BaseLayout>

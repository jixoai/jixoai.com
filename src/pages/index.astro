---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Jixo AI - Open Source AI Projects">
  <section class="container mx-auto px-4 py-16">
    <div class="text-center">
      <h1 class="text-5xl font-bold mb-4">Welcome to Jixo AI</h1>
      <p class="text-xl text-muted-foreground mb-8">
        Building the future of AI with open source
      </p>
      <div class="flex gap-4 justify-center">
        <a
          href="/projects"
          class="px-6 py-3 bg-primary text-primary-foreground rounded-md hover:opacity-90 transition-opacity"
        >
          Explore Projects
        </a>
        <a
          href="https://github.com/jixoai"
          target="_blank"
          rel="noopener noreferrer"
          class="px-6 py-3 border border-border rounded-md hover:bg-secondary transition-colors"
        >
          View on GitHub
        </a>
      </div>
    </div>
  </section>

  <section class="container mx-auto px-4 py-16">
    <h2 class="text-3xl font-bold mb-8 text-center">Featured Projects</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <!-- Projects will be dynamically loaded during build -->
    </div>
  </section>
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import { BlurFade } from '../components/magicui/blur-fade';
import { Card, CardContent } from '../components/ui/card';
import { Button } from '../components/ui/button';
import { Github, Twitter, Heart } from 'lucide-react';
---

<BaseLayout title="About - Jixo AI">
  <section class="container mx-auto px-4 py-16">
    <BlurFade delay={0.1} inView client:load>
      <div class="text-center mb-16">
        <h1 class="text-4xl md:text-5xl font-bold mb-6">About Jixo AI</h1>
        <p class="text-xl text-muted-foreground max-w-2xl mx-auto">
          Building the future of AI with open source technology. We believe in the power of collaboration and transparency.
        </p>
      </div>
    </BlurFade>

    <div class="grid md:grid-cols-2 gap-12 mb-16">
      <BlurFade delay={0.2} inView client:load>
        <Card className="h-full">
          <CardContent className="p-8">
            <h2 class="text-2xl font-bold mb-4">Our Mission</h2>
            <p class="text-muted-foreground leading-relaxed">
              Jixo AI is dedicated to developing innovative AI tools and solutions that empower developers and businesses.
              We focus on creating practical, production-ready AI applications that solve real-world problems while
              maintaining the highest standards of code quality and user experience.
            </p>
          </CardContent>
        </Card>
      </BlurFade>

      <BlurFade delay={0.3} inView client:load>
        <Card className="h-full">
          <CardContent className="p-8">
            <h2 class="text-2xl font-bold mb-4">Open Source Philosophy</h2>
            <p class="text-muted-foreground leading-relaxed">
              We believe that open source is the key to building better software. By sharing our work openly,
              we enable collaboration, foster innovation, and create a community of developers who can learn
              from and contribute to our projects. All our major tools are available on GitHub for everyone to use and improve.
            </p>
          </CardContent>
        </Card>
      </BlurFade>
    </div>

    <BlurFade delay={0.4} inView client:load>
      <div class="text-center mb-16">
        <h2 class="text-3xl font-bold mb-8">What We Build</h2>
        <div class="grid md:grid-cols-3 gap-6">
          <Card>
            <CardContent className="p-6 text-center">
              <div class="w-12 h-12 bg-primary/10 rounded-lg flex items-center justify-center mx-auto mb-4">
                <span class="text-2xl">🤖</span>
              </div>
              <h3 class="font-semibold mb-2">AI Tools</h3>
              <p class="text-sm text-muted-foreground">
                Intelligent automation tools that leverage cutting-edge AI models to enhance developer productivity.
              </p>
            </CardContent>
          </Card>

          <Card>
            <CardContent className="p-6 text-center">
              <div class="w-12 h-12 bg-primary/10 rounded-lg flex items-center justify-center mx-auto mb-4">
                <span class="text-2xl">📚</span>
              </div>
              <h3 class="font-semibold mb-2">Documentation</h3>
              <p class="text-sm text-muted-foreground">
                Comprehensive guides and documentation to help developers get started quickly with our tools.
              </p>
            </CardContent>
          </Card>

          <Card>
            <CardContent className="p-6 text-center">
              <div class="w-12 h-12 bg-primary/10 rounded-lg flex items-center justify-center mx-auto mb-4">
                <span class="text-2xl">🔧</span>
              </div>
              <h3 class="font-semibold mb-2">Developer SDKs</h3>
              <p class="text-sm text-muted-foreground">
                Easy-to-use SDKs and libraries that make integrating AI capabilities into your projects seamless.
              </p>
            </CardContent>
          </Card>
        </div>
      </div>
    </BlurFade>

    <BlurFade delay={0.5} inView client:load>
      <div class="text-center">
        <h2 class="text-3xl font-bold mb-4">Join Our Community</h2>
        <p class="text-muted-foreground mb-8 max-w-xl mx-auto">
          Connect with us on social media and join our growing community of AI enthusiasts and developers.
        </p>
        <div class="flex justify-center gap-4">
          <Button variant="default" size="lg" asChild>
            <a href="https://github.com/jixoai" target="_blank" rel="noopener noreferrer" class="flex items-center gap-2">
              <Github className="h-5 w-5" />
              GitHub
            </a>
          </Button>
          <Button variant="outline" size="lg" asChild>
            <a href="https://twitter.com/jixoai" target="_blank" rel="noopener noreferrer" class="flex items-center gap-2">
              <Twitter className="h-5 w-5" />
              Twitter
            </a>
          </Button>
        </div>
        <p class="mt-8 text-sm text-muted-foreground flex items-center justify-center gap-1">
          Built with <Heart className="h-4 w-4 text-destructive" /> by the Jixo AI team
        </p>
      </div>
    </BlurFade>
  </section>
</BaseLayout>
